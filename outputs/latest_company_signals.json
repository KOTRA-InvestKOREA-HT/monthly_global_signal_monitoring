    "source_direct_url": "https://www.bayer.com/media/en-us/us-fda-grants-accelerated-approval-to-bayers-targeted-therapy-sevabertinib-as-a-first-line-treatment-option-for-adults-with-her2-mutant-non-small-cell-lung-cancer/",
    "link_verdict": "accept",
