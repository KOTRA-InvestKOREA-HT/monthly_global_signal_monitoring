    "official_source_url": "https://www.siemens-energy.com/global/en/home/investor-relations/publications-ad-hoc.html",
    "source_direct_url": "https://www.siemens-energy.com/global/en/home/press-releases/siemens-energy-to-accelerate-its-journey-to-deliver-profitable-g.html",
