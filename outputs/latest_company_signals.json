    "source_direct_url": "https://www.evonik.com/en/news/press-releases/2026/08/evonik-expands-lipid-based-drug-delivery-capabilities-with-new-gmp-manufacturing-facility-in-vancouver-canada.html",
    "link_verdict": "accept",
