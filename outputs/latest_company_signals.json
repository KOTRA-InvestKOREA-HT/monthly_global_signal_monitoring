    "query": "(\"EVG\" OR \"EV Group\") (\"hybrid bonding\" OR \"wafer bonding\" OR \"advanced packaging\" OR \"bonding equipment\" OR \"die bonding\" OR \"semiconductor packaging\") after:2026-08-01 before:2026-09-01",
