{
  "name": "company-signal-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "report:review": "node scripts/review_report.mjs",
    "report:publish": "node scripts/publish_report.mjs",
    "report:local": "node scripts/local_report.mjs",
    "audit:coverage": "node scripts/audit_signal_coverage.mjs",
    "test": "node --test",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "validate:pdf": "python scripts/extract_pdf_companies.py --pdf \"docs/Invest KOREA_기업글로벌시그널_2호 (참고본).pdf\" --page 2 --expected data/target_companies.json --out-dir outputs/pdf_verify",
    "build:technology-map": "python scripts/build_company_technology_map.py --targets data/target_companies.json --keywords config/technology_keywords.json --out-json data/company_technology_map.json --out-csv data/company_technology_map.csv",
    "collect": "node --use-system-ca scripts/collection_args.mjs --out-dir outputs --days 45",
    "validate:report-inputs": "node scripts/validate_report_inputs.mjs"
  },
  "dependencies": {
    "@sparticuz/chromium-min": "153.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "puppeteer-core": "25.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
